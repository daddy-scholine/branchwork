rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Each person's own tree, log and follows: only they can read or write.
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Public name/photo and stats (level, badges, streak).
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }

    // Feed
    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
      allow update: if signedIn() && (resource.data.uid == me()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reacts']));
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == me();
        allow delete: if signedIn() && resource.data.uid == me();
      }
    }

    // Battles: anyone signed in can join; each person only changes their own score.
    match /battles/{bid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creator == me();
      allow delete: if signedIn() && resource.data.creator == me();
      allow update: if signedIn() && (resource.data.creator == me()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])));
      match /chat/{mid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == me();
      }
    }
  }
}
